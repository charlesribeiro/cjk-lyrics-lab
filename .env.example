# OpenAI API Configuration
# Get your API key from https://platform.openai.com/
OPENAI_API_KEY=sk-your-openai-api-key-here

# n8n Configuration
N8N_USER=admin
N8N_PASSWORD=admin

# Lyrics API Keys (for n8n workflows)
# Get Genius API token from https://genius.com/api-clients
GENIUS_API_TOKEN=your-genius-api-token-here

# Get Musixmatch API key from https://developer.musixmatch.com/
MUSIXMATCH_API_KEY=your-musixmatch-api-key-here

# Optional: Custom OpenAI API URL (defaults to https://api.openai.com/v1)
# OPENAI_API_URL=https://api.openai.com/v1

# Optional: Custom n8n webhook URL
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/scrobble
